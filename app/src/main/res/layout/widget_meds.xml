<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="rtl"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@drawable/widget_bg">

    <TextView
        android:id="@+id/med_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="💊 الجرعة الجاية"
        android:textColor="#4A5A4F"
        android:textSize="12sp" />

    <LinearLayout
        android:id="@+id/med_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/med_line1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#347B52"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/med_line2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#4A5A4F"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/med_line3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#4A5A4F"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/med_line4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#4A5A4F"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/med_line5"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#4A5A4F"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/med_take"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/widget_button_bg"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:text="أخدتها ✓"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold" />
</LinearLayout>
